# ============================================
# Azure Service Principal Authentication
# ============================================
# Create service principal using: scripts/setup-service-principal.ps1
AZURE_CLIENT_ID=your-service-principal-client-id
AZURE_CLIENT_SECRET=your-service-principal-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_SUBSCRIPTION_ID=7c77785e-55b1-434e-914a-f520f3234923

# Authentication mode (always use service_principal)
AUTH_MODE=service_principal

# ============================================
# Azure AI Foundry Configuration (GPT-4o)
# ============================================
# Get endpoint and API key from Azure Portal -> Your Foundry Hub -> Keys and Endpoint
AZURE_FOUNDRY_ENDPOINT=https://your-foundry-project.openai.azure.com/
AZURE_FOUNDRY_API_KEY=your-foundry-api-key
AZURE_FOUNDRY_DEPLOYMENT_NAME=gpt-4o
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview

# ============================================
# Azure Cosmos DB Configuration
# ============================================
COSMOS_DB_ENDPOINT=https://your-cosmosdb.documents.azure.com:443/
COSMOS_DB_KEY=your-cosmos-key
COSMOS_DB_DATABASE_NAME=resourcetagger
COSMOS_DB_CONTAINER_NAME=resources

# ============================================
# Application Configuration
# ============================================
API_PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO
